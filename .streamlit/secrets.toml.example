# 이 파일을 secrets.toml 로 복사해서 값을 채우세요. secrets.toml 은 git에 올리지 않습니다.
# Streamlit Community Cloud에서는 앱 Settings > Secrets 에 같은 내용을 붙여 넣습니다.

APP_PASSWORD = "pnumis"

# AI 모델 (OpenAI 호환 API). 기본은 Groq.
GROQ_API_KEY = ""
# GROQ_MODEL = "openai/gpt-oss-120b"

# 다른 OpenAI 호환 서비스를 쓰려면 아래 세 값을 대신 채웁니다. 예시는 Google Gemini(무료 키: aistudio.google.com/apikey).
# LLM_MODEL에 쉼표로 여러 모델을 적으면, 앞 모델이 혼잡하거나 늦을 때 다음 모델로 넘어갑니다.
# LLM_API_KEY = ""
# LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_MODEL = "gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash"

# 웹 검색 (공식 일정·학습자료 확인)
TAVILY_API_KEY = ""

# 사용자 계정·학습 상태를 영구 저장할 DB (없으면 앱 서버 임시 저장)
# SUPABASE_URL = "https://xxxx.supabase.co"
# SUPABASE_KEY = ""   # service_role 키. 절대 git에 올리지 마세요.

# 사용자별 Google Calendar 연동 (Google Cloud Console > OAuth 클라이언트 ID, 유형: 웹 애플리케이션)
# GOOGLE_REDIRECT_URI 는 배포된 앱 주소와 정확히 같아야 합니다. 예: https://<앱이름>.streamlit.app
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
GOOGLE_REDIRECT_URI = ""
